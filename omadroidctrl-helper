#!/usr/bin/env bash
# omadroidctrl helper: everything that touches adb, scrcpy, mDNS and Hyprland.
#
# The QML side never shells out on its own; it runs this script and reads
# JSON. Long-running commands (pair, connect) stream one JSON event per line so
# the panel can show progress. Everything else prints a single JSON object.
#
#   omadroidctrl-helper status  [--tailnet-host H] [--tailnet-port P] [--lan-timeout S]
#   omadroidctrl-helper pair    [--timeout S]
#   omadroidctrl-helper connect [--target host:port] [--timeout S]
#   omadroidctrl-helper disconnect [serial]
#   omadroidctrl-helper tcpip   [--port 5555]
#   omadroidctrl-helper mirror  --mode docked|window [--align right|center|left]
#                               [--width PX] [--max-size N] [--bit-rate MBPS]
#                               [--turn-screen-off] [--stay-awake] [--show-touches]
#                               [--no-audio] [--extra "ARGS"] [--serial S]
#   omadroidctrl-helper install   (missing packages + avahi-daemon, in a terminal)
#   omadroidctrl-helper dock | undock | stop | log [N]
#
# Everything is logged to $XDG_STATE_HOME/omadroidctrl/helper.log.
set -euo pipefail

WINDOW_TITLE="omadroidctrl"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omadroidctrl"
MIRROR_STATE="$STATE_DIR/mirror.json"
PAIR_PNG="$STATE_DIR/pair.png"
LOG_FILE="$STATE_DIR/helper.log"
GAP=8

# Read /proc/<pid>/stat fields after the closing paren of the (comm) token.
# /proc/<pid>/stat layout (per proc(5)):
#   field 1: pid
#   field 2: (comm) — can contain spaces and parens if a thread was renamed
#             via prctl(PR_SET_NAME), e.g. "(weird)name)" — the closing ")"
#             is the LAST ")" on the line, not the first.
#   field 3+: state, ppid, pgrp, ..., starttime (field 22).
#
# To read any post-comm field robustly we find the LAST ")" (by iterating
# from the end of the line) and take the requested whitespace-separated
# index from the tokens that follow it. `awk`'s `index()` returns the FIRST
# occurrence, which is wrong for comms containing ")".
#
# Usage: pid_stat_field <pid> <1-based proc field index after comm>
pid_stat_field() {
  local pid=$1 want_field=$2
  [[ -r /proc/$pid/stat ]] || return 1
  awk -v want="$want_field" '
    {
      n = length($0)
      last = 0
      for (i = n; i >= 1; i--) if (substr($0, i, 1) == ")") { last = i; break }
      if (last == 0) exit 1
      rest = substr($0, last + 1)
      i = 0
      nf = split(rest, a, " ")
      for (j = 1; j <= nf; j++) if (a[j] != "") { i++; if (i == want) { print a[j]; exit } }
    }' "/proc/$pid/stat" 2>/dev/null
}

# Read /proc/<pid>/stat field 22 (starttime in clock ticks since boot). Used
# by mirror_pid to verify a PID still belongs to the process we launched
# (PID reuse by the kernel would produce a different starttime).
pid_starttime() {
  pid_stat_field "$1" 20
}

# Read /proc/<pid>/stat field 5 (process group ID). Used to terminate
# scrcpy via its process group (kill -- -$pgid).
pid_pgid() {
  pid_stat_field "$1" 3
}

# Read the literal command line of a PID. Returns empty if /proc is unavailable
# or the cmdline contains NULs (it always does — we strip them). Useful for
# debug logging and ad-hoc verification.
pid_cmdline() {
  local pid=$1
  [[ -r /proc/$pid/cmdline ]] || return 1
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null
}

# Read the literal command line of a PID. Returns empty if /proc is unavailable
# or the cmdline contains NULs (it always does — we strip them).
pid_cmdline() {
  local pid=$1
  [[ -r /proc/$pid/cmdline ]] || return 1
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null
}

mkdir -p "$STATE_DIR"

have() { command -v "$1" >/dev/null 2>&1; }

# Append one timestamped line to the log; rotate once past 1 MB.
log() {
  if [[ -f $LOG_FILE ]] && (( $(stat -c %s "$LOG_FILE" 2>/dev/null || echo 0) > 1048576 )); then
    mv -f "$LOG_FILE" "$LOG_FILE.1"
  fi
  printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$$" "$*" >>"$LOG_FILE"
}

json_error() {
  log "error: $1"
  jq -cn --arg error "$1" '{ok:false,error:$error}'
  exit 1
}

event() {
  # event NAME [jq-args...]  -> one JSON line with "event": NAME
  local name=$1; shift
  local line
  line=$(jq -cn --arg event "$name" "$@" '{event:$event} + $ARGS.named')
  log "event: $line"
  printf '%s\n' "$line"
}

need() {
  for tool in "$@"; do have "$tool" || json_error "$tool is not installed"; done
}

# Arch packages behind the commands this helper uses, one per line, missing ones only.
missing_packages() {
  local cmd pkg
  for pair in jq:jq adb:android-tools scrcpy:scrcpy avahi-browse:avahi qrencode:qrencode; do
    cmd=${pair%%:*} pkg=${pair#*:}
    have "$cmd" || printf '%s\n' "$pkg"
  done
}

# Read-only check — used by status reporting only. The plugin never enables
# avahi-daemon itself; the user opts in if they want LAN discovery over mDNS.
avahi_daemon_running() { systemctl is-active --quiet avahi-daemon.service 2>/dev/null; }

# Built by hand: this must work before jq is installed.
json_strings() {
  local out="" item
  for item in "$@"; do out+="${out:+,}\"$item\""; done
  printf '[%s]' "$out"
}

# ------------------------------------------------------------------ discovery

# Print "host port name" for every IPv4 instance of an adb mDNS service type.
browse() {
  local type=$1 raw
  have avahi-browse || return 0
  # Fast path: if the daemon isn't running, skip the network roundtrip and
  # let the caller fall through to `adb mdns` / manual entry. This avoids
  # the 4-second `timeout` on every connect attempt.
  if ! avahi_daemon_running; then return 0; fi
  raw=$(timeout 4 avahi-browse -rpt "$type" 2>/dev/null || true)
  if [[ -n $raw ]]; then
    log "avahi $type: $(grep -c '^=' <<<"$raw") resolved"
    grep '^=' <<<"$raw" | cut -c1-200 | while IFS= read -r l; do log "  $l"; done
  fi
  awk -F';' '$1=="=" && $3=="IPv4" && $8 != "" && $9 != "" { print $8, $9, $4 }' <<<"$raw" | sort -u || true
}

browse_json() {
  browse "$1" | jq -Rc 'split(" ") | select(length >= 3) | {host:.[0], port:(.[1]|tonumber), name:(.[2:]|join(" "))}' | jq -sc '.'
}

# --------------------------------------------------------------------- state

mirror_pid() {
  [[ -f $MIRROR_STATE ]] || return 1
  local pid starttime live_starttime
  pid=$(jq -r '.pid // empty' "$MIRROR_STATE" 2>/dev/null) || return 1
  starttime=$(jq -r '.starttime // empty' "$MIRROR_STATE" 2>/dev/null) || return 1
  [[ -n $pid ]] || return 1
  # PID-reuse hardening: the recorded PID must still be alive AND its kernel-
  # assigned starttime (clock ticks since boot, field 22 of /proc/<pid>/stat)
  # must match. The kernel assigns a fresh starttime to every new process, so
  # if the OS reuses this PID for an unrelated process the starttime will
  # differ and we drop the stale state.
  #
  # We refuse to verify if the state file has no recorded starttime: older
  # versions of this helper would record an empty starttime when /proc
  # couldn't be read at launch, which would silently bypass this check.
  # Treat missing starttime as a verification failure.
  [[ -n $starttime ]] || { log "mirror_pid: state file has no recorded starttime; refusing to verify"; return 1; }
  kill -0 "$pid" 2>/dev/null || { rm -f "$MIRROR_STATE"; return 1; }
  live_starttime=$(pid_starttime "$pid" 2>/dev/null || echo)
  if [[ -z $live_starttime || $live_starttime != "$starttime" ]]; then
    log "mirror_pid: pid $pid reuse detected (live starttime '$live_starttime' != recorded '$starttime')"
    rm -f "$MIRROR_STATE"
    return 1
  fi
  printf '%s\n' "$pid"
}

mirror_json() {
  local pid
  if pid=$(mirror_pid); then
    jq -c --argjson pid "$pid" '. + {running:true, pid:$pid}' "$MIRROR_STATE"
  else
    rm -f "$MIRROR_STATE"
    printf '{"running":false}\n'
  fi
}

# Hyprland client address for the mirror window, if it is mapped.
mirror_address() {
  have hyprctl || return 1
  hyprctl clients -j 2>/dev/null | jq -r --arg t "$WINDOW_TITLE" '.[] | select(.title == $t or .initialTitle == $t) | .address' | head -1 | grep . || return 1
}

# ----------------------------------------------------------------------- adb

devices_json() {
  have adb || { printf '[]\n'; return; }
  adb devices -l 2>/dev/null | awk 'NR > 1 && NF >= 2 { print }' | while read -r serial state rest; do
    local model
    model=$(printf '%s\n' "$rest" | grep -o 'model:[^ ]*' | cut -d: -f2 | tr '_' ' ')
    local wireless=false
    [[ $serial == *:* ]] && wireless=true
    jq -cn --arg serial "$serial" --arg state "$state" --arg model "$model" --argjson wireless "$wireless" \
      '{serial:$serial,state:$state,model:$model,wireless:$wireless}'
  done | jq -sc '.'
}

active_serial() {
  # First ready device, preferring wireless ones; explicit --serial wins upstream.
  devices_json | jq -r '[.[] | select(.state == "device")] | sort_by(.wireless | not) | .[0].serial // empty'
}

# -------------------------------------------------------------------- status

cmd_status() {
  local tailnet_host="" tailnet_port=5555 lan_timeout=3
  while [[ $# -gt 0 ]]; do
    case $1 in
      --tailnet-host) tailnet_host=$2; shift 2 ;;
      --tailnet-port) tailnet_port=$2; shift 2 ;;
      --lan-timeout) lan_timeout=$2; shift 2 ;;
      *) shift ;;
    esac
  done
  local missing
  mapfile -t missing < <(missing_packages)
  have jq || { printf '{"ok":false,"error":"jq is not installed","missing":%s}\n' "$(json_strings "${missing[@]}")"; exit 1; }
  local deps devices connect pairing mirror
  deps=$(jq -cn \
    --argjson adb "$(have adb && echo true || echo false)" \
    --argjson scrcpy "$(have scrcpy && echo true || echo false)" \
    --argjson avahi "$(have avahi-browse && echo true || echo false)" \
    --argjson qrencode "$(have qrencode && echo true || echo false)" \
    --argjson hyprctl "$(have hyprctl && echo true || echo false)" \
    --argjson avahiDaemon "$(avahi_daemon_running && echo true || echo false)" \
    '{adb:$adb,scrcpy:$scrcpy,avahi:$avahi,qrencode:$qrencode,hyprctl:$hyprctl,avahiDaemon:$avahiDaemon}')
  devices=$(devices_json)
  connect=$(browse_json _adb-tls-connect._tcp)
  pairing=$(browse_json _adb-tls-pairing._tcp)
  mirror=$(mirror_json)
  local paired=false
  [[ -s ${ANDROID_USER_HOME:-$HOME/.android}/adbkey ]] && paired=true
  jq -cn \
    --argjson deps "$deps" --argjson devices "$devices" --argjson connect "$connect" \
    --argjson pairing "$pairing" --argjson mirror "$mirror" --argjson paired "$paired" \
    --argjson missing "$(json_strings "${missing[@]}")" \
    --arg tailnetHost "$tailnet_host" --argjson tailnetPort "$tailnet_port" \
    '{
      schemaVersion: 1,
      deps: $deps,
      missing: $missing,
      devices: $devices,
      active: ([$devices[] | select(.state == "device")] | sort_by(.wireless | not) | .[0] // null),
      lan: {connect: $connect, pairing: $pairing},
      mirror: $mirror,
      hostKey: $paired,
      tailnet: {host: $tailnetHost, port: $tailnetPort}
    }'
}

# ---------------------------------------------------------------------- pair

cmd_pair() {
  local timeout_s=120
  while [[ $# -gt 0 ]]; do
    case $1 in --timeout) timeout_s=$2; shift 2 ;; *) shift ;; esac
  done
  need adb avahi-browse qrencode jq
  # The panel cancels pairing with SIGTERM; never leave a stale code behind.
  trap 'rm -f "$PAIR_PNG"' EXIT
  local suffix name code
  # Read a bounded chunk first: an unbounded tr over /dev/urandom dies of
  # SIGPIPE when head closes, which pipefail turns into a silent exit.
  suffix=$(head -c 256 /dev/urandom | LC_ALL=C tr -dc 'a-z0-9' | cut -c1-6)
  name="omadroidctrl-$suffix"
  code=$(printf '%06d' "$(( (RANDOM * 32768 + RANDOM) % 1000000 ))")
  qrencode -s 8 -m 2 -t PNG -o "$PAIR_PNG" "WIFI:T:ADB;S:$name;P:$code;;"
  event qr --arg qrPath "$PAIR_PNG" --arg name "$name" --arg code "$code" --argjson timeout "$timeout_s"

  log "pair: waiting up to ${timeout_s}s for a pairing service (requested name $name)"
  local deadline=$(( $(date +%s) + timeout_s )) found line host port
  while :; do
    found=$(browse _adb-tls-pairing._tcp) || true
    # Prefer the instance named after our QR; otherwise take any pairing
    # service, since phones do not always honour the requested name.
    line=$(awk -v n="$name" '$3 == n { print; exit }' <<<"$found")
    [[ -n $line ]] || line=$(head -1 <<<"$found")
    if [[ -n $line ]]; then
      host=$(cut -d' ' -f1 <<<"$line"); port=$(cut -d' ' -f2 <<<"$line")
      log "pair: using pairing service $line"
      break
    fi
    if (( $(date +%s) >= deadline )); then
      rm -f "$PAIR_PNG"
      event timeout --arg message "No phone scanned the code within ${timeout_s}s"
      exit 0
    fi
    sleep 1
  done
  event pairing --arg host "$host" --argjson port "$port"
  local out
  out=$(timeout 30 adb pair "$host:$port" "$code" 2>&1) && log "adb pair: $out" || {
    log "adb pair failed: $out"
    rm -f "$PAIR_PNG"
    event error --arg message "adb pair failed: $(tr '\n' ' ' <<<"${out:-timed out}")"
    exit 0
  }
  rm -f "$PAIR_PNG"
  event paired --arg host "$host" --argjson port "$port"
  # The connect service can take a few seconds to show up after pairing.
  connect_lan "$host" 30 || true
}

# ------------------------------------------------------------------- connect

# Discover _adb-tls-connect on the LAN (optionally only for HOST) and connect.
connect_lan() {
  local want_host=${1:-} timeout_s=${2:-15}
  local deadline=$(( $(date +%s) + timeout_s )) line host port out
  log "connect: waiting up to ${timeout_s}s for a connect service${want_host:+ from $want_host}"
  while :; do
    line=$(awk -v h="$want_host" 'h == "" || $1 == h { print; exit }' <<<"$(browse _adb-tls-connect._tcp)")
    if [[ -n $line ]]; then
      host=$(cut -d' ' -f1 <<<"$line"); port=$(cut -d' ' -f2 <<<"$line")
      out=$(timeout 20 adb connect "$host:$port" 2>&1) || true
      log "adb connect $host:$port: $out"
      if grep -qi "connected" <<<"$out" && ! grep -qi "failed\|cannot\|unable" <<<"$out"; then
        event connected --arg serial "$host:$port" --arg message "$(tr '\n' ' ' <<<"$out")"
        return 0
      fi
      event error --arg message "adb connect $host:$port: $(tr '\n' ' ' <<<"${out:-timed out}")"
      return 1
    fi
    if (( $(date +%s) >= deadline )); then
      event timeout --arg message "No phone advertising wireless debugging on this network. Unlock the phone and open Developer options → Wireless debugging."
      return 1
    fi
    sleep 1
  done
}

cmd_connect() {
  local target="" timeout_s=15
  while [[ $# -gt 0 ]]; do
    case $1 in
      --target) target=$2; shift 2 ;;
      --timeout) timeout_s=$2; shift 2 ;;
      *) shift ;;
    esac
  done
  need adb jq
  if [[ -n $target ]]; then
    [[ $target == *:* ]] || target="$target:5555"
    local out
    out=$(timeout 15 adb connect "$target" 2>&1) || true
    log "adb connect $target: $out"
    if grep -qi "connected" <<<"$out" && ! grep -qi "failed\|cannot\|unable" <<<"$out"; then
      event connected --arg serial "$target" --arg message "$(tr '\n' ' ' <<<"$out")"
    else
      event error --arg message "adb connect $target: $(tr '\n' ' ' <<<"${out:-timed out}")"
    fi
    return 0
  fi
  need avahi-browse
  connect_lan "" "$timeout_s" || true
}

cmd_disconnect() {
  need adb jq
  local serial=${1:-}
  if [[ -n $serial ]]; then adb disconnect "$serial" >/dev/null 2>&1 || true
  else adb disconnect >/dev/null 2>&1 || true
  fi
  jq -cn '{ok:true}'
}

cmd_tcpip() {
  local port=5555 serial=""
  while [[ $# -gt 0 ]]; do
    case $1 in --port) port=$2; shift 2 ;; --serial) serial=$2; shift 2 ;; *) shift ;; esac
  done
  need adb jq
  [[ -n $serial ]] || serial=$(active_serial)
  [[ -n $serial ]] || json_error "no connected device to switch to tcpip mode"
  local out
  if out=$(adb -s "$serial" tcpip "$port" 2>&1); then
    jq -cn --arg message "$(tr '\n' ' ' <<<"$out")" --argjson port "$port" '{ok:true,port:$port,message:$message}'
  else
    json_error "adb tcpip failed: $(tr '\n' ' ' <<<"$out")"
  fi
}

# -------------------------------------------------------------------- mirror

# Geometry of the monitor holding window ADDRESS (or the focused one):
# "x y width height reserved_top scale". x/y are logical layout coordinates,
# width/height are physical pixels.
window_monitor() {
  local address=${1:-} mon
  mon=$(hyprctl clients -j 2>/dev/null | jq -r --arg a "$address" '.[] | select(.address == $a) | .monitor' | head -1)
  hyprctl monitors -j 2>/dev/null | jq -r --arg mon "${mon:-}" '
    ((map(select(($mon != "" and (.id|tostring) == $mon))) | .[0]) // (map(select(.focused)) | .[0]) // .[0])
    | "\(.x) \(.y) \(.width) \(.height) \(.reserved[1]) \(.scale)"'
}

# Hyprland 0.56+ takes Lua through `hyprctl repl`; older releases take the
# classic dispatcher syntax. Both float, pin, size and place the window.
hypr_lua() { hyprctl --help 2>/dev/null | grep -q '^\s*repl'; }

hypr_dock_window() {
  local address=$1 width=$2 height=$3 x=$4 y=$5 out
  if hypr_lua; then
    out=$(hyprctl repl "local w = hl.get_window('address:$address') if not w then return 'no window' end
      if not w.floating then hl.dispatch(hl.dsp.window.float({ window = w })) end
      if not w.pinned then hl.dispatch(hl.dsp.window.pin({ window = w })) end
      if $height > 0 then hl.dispatch(hl.dsp.window.resize({ x = $width, y = $height, exact = true, window = w })) end
      hl.dispatch(hl.dsp.window.move({ x = $x, y = $y, exact = true, window = w }))
      return 'floating='..tostring(w.floating)..' pinned='..tostring(w.pinned)" 2>&1)
  else
    out=$(hyprctl --batch "dispatch setfloating address:$address; dispatch pin address:$address" 2>&1)
    (( height > 0 )) && out+=$'\n'$(hyprctl dispatch resizewindowpixel exact "$width" "$height",address:"$address" 2>&1)
    out+=$'\n'$(hyprctl dispatch movewindowpixel exact "$x" "$y",address:"$address" 2>&1)
  fi
  log "dock: hyprctl -> $(tr '\n' ' ' <<<"$out")"
}

hypr_undock_window() {
  local address=$1 out
  if hypr_lua; then
    out=$(hyprctl repl "local w = hl.get_window('address:$address') if not w then return 'no window' end
      if w.pinned then hl.dispatch(hl.dsp.window.pin({ window = w })) end
      if w.floating then hl.dispatch(hl.dsp.window.float({ window = w })) end
      return 'floating='..tostring(w.floating)..' pinned='..tostring(w.pinned)" 2>&1)
  else
    local pinned floating
    read -r pinned floating < <(hyprctl clients -j | jq -r --arg a "$address" '.[] | select(.address == $a) | "\(.pinned) \(.floating)"')
    out=""
    [[ $pinned == true ]] && out+=$(hyprctl dispatch pin address:"$address" 2>&1)
    [[ $floating == true ]] && out+=$'\n'$(hyprctl dispatch settiled address:"$address" 2>&1)
  fi
  log "undock: hyprctl -> $(tr '\n' ' ' <<<"$out")"
}

# Float, pin and park the mirror window under the bar.
apply_dock() {
  local address=$1 align=$2 width=$3
  log "dock: window $address align=$align width=$width"
  local mx my mw mh top scale
  read -r mx my mw mh top scale < <(window_monitor "$address")
  # hyprctl geometry is in physical pixels; window sizes below are logical.
  local lw lh
  lw=$(awk -v w="$mw" -v s="$scale" 'BEGIN { printf "%d", w / s }')
  local wh
  wh=$(hyprctl clients -j | jq -r --arg a "$address" '.[] | select(.address == $a) | "\(.size[0]) \(.size[1])"')
  local cur_w cur_h
  read -r cur_w cur_h <<<"${wh:-0 0}"
  local h=0
  if (( cur_w > 0 && cur_h > 0 )); then h=$(( width * cur_h / cur_w )); fi
  local x
  case $align in
    left) x=$(( mx + GAP )) ;;
    center) x=$(( mx + (lw - width) / 2 )) ;;
    *) x=$(( mx + lw - width - GAP )) ;;
  esac
  local y=$(( my + top + GAP ))
  log "dock: geometry x=$x y=$y w=$width h=$h (monitor ${mw}x${mh}@${scale} at $mx,$my, reserved top $top)"
  hypr_dock_window "$address" "$width" "$h" "$x" "$y"
}

wait_for_window() {
  local tries=${1:-40} address
  while (( tries-- > 0 )); do
    if address=$(mirror_address); then printf '%s\n' "$address"; return 0; fi
    sleep 0.25
  done
  return 1
}

cmd_mirror() {
  local mode=docked align=right width=420 max_size=0 bit_rate=0 serial="" extra=""
  local screen_off=false stay_awake=false show_touches=false no_audio=false
  while [[ $# -gt 0 ]]; do
    case $1 in
      --mode) mode=$2; shift 2 ;;
      --align) align=$2; shift 2 ;;
      --width) width=$2; shift 2 ;;
      --max-size) max_size=$2; shift 2 ;;
      --bit-rate) bit_rate=$2; shift 2 ;;
      --serial) serial=$2; shift 2 ;;
      --extra) extra=$2; shift 2 ;;
      --turn-screen-off) screen_off=true; shift ;;
      --stay-awake) stay_awake=true; shift ;;
      --show-touches) show_touches=true; shift ;;
      --no-audio) no_audio=true; shift ;;
      *) shift ;;
    esac
  done
  need adb scrcpy jq
  if mirror_pid >/dev/null; then
    jq -c '. + {ok:true, already:true}' <(mirror_json)
    return 0
  fi
  [[ -n $serial ]] || serial=$(active_serial)
  [[ -n $serial ]] || json_error "no connected device to mirror"

  local -a argv=(scrcpy -s "$serial" "--window-title=$WINDOW_TITLE")
  (( max_size > 0 )) && argv+=("--max-size=$max_size")
  (( bit_rate > 0 )) && argv+=("--video-bit-rate=${bit_rate}M")
  [[ $screen_off == true ]] && argv+=(--turn-screen-off)
  [[ $stay_awake == true ]] && argv+=(--stay-awake)
  [[ $show_touches == true ]] && argv+=(--show-touches)
  [[ $no_audio == true ]] && argv+=(--no-audio)
  if [[ $mode == docked ]]; then
    argv+=(--window-borderless --always-on-top "--window-width=$width")
  fi
  if [[ -n $extra ]]; then
    # shellcheck disable=SC2206
    local -a extra_args=($extra)
    argv+=("${extra_args[@]}")
  fi

  log "mirror: ${argv[*]}"
  setsid "${argv[@]}" >"$STATE_DIR/scrcpy.log" 2>&1 < /dev/null &
  local pid=$!
  # Record the kernel-issued starttime (defeats PID reuse) and the process
  # group ID (lets cmd_stop kill -- -$pgid to terminate the whole process
  # group atomically instead of pattern-matching other scrcpy processes).
  # We refuse to launch if we can't read the starttime: without it, the
  # starttime verification in mirror_pid would be skipped, falling back to
  # the original kill -0 check that is vulnerable to PID reuse. Failing
  # closed here is the safer choice — if /proc is unreadable right now,
  # nothing about this mirror is safe to track.
  local starttime pgid
  starttime=$(pid_starttime "$pid" 2>/dev/null || echo "")
  pgid=$(pid_pgid "$pid" 2>/dev/null || echo "")
  if [[ -z $starttime || -z $pgid ]]; then
    log "mirror: failed to read starttime/pgid for pid $pid; aborting"
    kill -- -"$pgid" 2>/dev/null || true
    wait $pid 2>/dev/null || true
    jq -cn --arg error "could not read /proc/$pid/stat (missing starttime or pgid); mirror aborted for safety" \
      '{ok:false,error:$error}'
    exit 1
  fi
  jq -cn --argjson pid "$pid" --arg mode "$mode" --arg align "$align" --argjson width "$width" --arg serial "$serial" \
    --arg starttime "$starttime" --argjson pgid "$pgid" \
    '{pid:$pid,mode:$mode,align:$align,width:$width,serial:$serial,starttime:$starttime,pgid:$pgid}' >"$MIRROR_STATE"

  if [[ $mode == docked ]] && have hyprctl; then
    local address
    if address=$(wait_for_window 40); then apply_dock "$address" "$align" "$width"; fi
  fi
  sleep 0.5
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$MIRROR_STATE"
    log "scrcpy exited early; log follows"; tail -n 20 "$STATE_DIR/scrcpy.log" 2>/dev/null | while IFS= read -r l; do log "  scrcpy: $l"; done
    json_error "scrcpy exited: $(tail -n 3 "$STATE_DIR/scrcpy.log" 2>/dev/null | tr '\n' ' ')"
  fi
  log "mirror: scrcpy pid $pid running ($mode)"
  jq -cn --argjson pid "$pid" --arg mode "$mode" --arg serial "$serial" '{ok:true,pid:$pid,mode:$mode,serial:$serial}'
}

cmd_dock() {
  need hyprctl jq
  local align=right width=420
  while [[ $# -gt 0 ]]; do
    case $1 in --align) align=$2; shift 2 ;; --width) width=$2; shift 2 ;; *) shift ;; esac
  done
  local address
  address=$(mirror_address) || json_error "no mirror window to dock"
  apply_dock "$address" "$align" "$width"
  if [[ -f $MIRROR_STATE ]]; then
    jq -c --arg align "$align" --argjson width "$width" '. + {mode:"docked",align:$align,width:$width}' "$MIRROR_STATE" >"$MIRROR_STATE.next" && mv "$MIRROR_STATE.next" "$MIRROR_STATE"
  fi
  jq -cn '{ok:true,mode:"docked"}'
}

cmd_undock() {
  need hyprctl jq
  local address
  address=$(mirror_address) || json_error "no mirror window to pop out"
  hypr_undock_window "$address"
  if [[ -f $MIRROR_STATE ]]; then
    jq -c '. + {mode:"window"}' "$MIRROR_STATE" >"$MIRROR_STATE.next" && mv "$MIRROR_STATE.next" "$MIRROR_STATE"
  fi
  jq -cn '{ok:true,mode:"window"}'
}

cmd_log() {
  local n=${1:-40}
  jq -cn --arg path "$LOG_FILE" --arg scrcpy "$STATE_DIR/scrcpy.log" \
    --argjson lines "$( { tail -n "$n" "$LOG_FILE" 2>/dev/null || true; } | jq -Rs 'split("\n") | map(select(. != ""))')" \
    '{path:$path,scrcpyLog:$scrcpy,lines:$lines}'
}

cmd_stop() {
  need jq
  # Stop uses process-group kill as the single source of truth. setsid(1)
  # made scrcpy the leader of its own process group, so `kill -- -$pgid`
  # signals scrcpy AND its descendants atomically, with the boundary
  # enforced by the kernel. We do not match against the cmdline or window
  # title any more — process-group isolation is the right primitive.
  #
  # Before signalling we MUST verify the PID is still ours (mirror_pid
  # re-checks /proc/<pid>/stat starttime). Only if that passes do we
  # signal the recorded process group. PGID reuse is unlikely in practice
  # (no auto-recycling by the kernel) but we still refuse to signal a
  # group ID whose owning process we can't verify — defensive correctness.
  local pgid
  pgid=$(jq -r '.pgid // empty' "$MIRROR_STATE" 2>/dev/null || echo)

  if [[ -n $pgid ]] && mirror_pid >/dev/null; then
    log "stop: killing scrcpy via verified process group -$pgid"
    # Negative PID syntax targets the whole process group atomically.
    kill -- -"$pgid" 2>/dev/null || true
  else
    log "stop: no verified mirror to stop (state cleared)"
  fi
  rm -f "$MIRROR_STATE"
  jq -cn '{ok:true}'
}

# Install what is missing in a floating terminal, where sudo can prompt. The
# panel's status polling notices when it is done. No jq: it may be what is missing.
#
# This never touches systemd. The plugin stays opt-in about avahi-daemon — the
# LAN-discovery helper (`browse`) works whenever avahi-browse is on $PATH,
# regardless of whether the daemon is active. Users who want LAN auto-discovery
# enable the daemon themselves (see README → "Optional: enable avahi-daemon").
cmd_install() {
  local pkgs steps=()
  mapfile -t pkgs < <(missing_packages)
  (( ${#pkgs[@]} )) && steps+=("omarchy-pkg-add ${pkgs[*]}")
  if (( ${#steps[@]} == 0 )); then
    printf '{"ok":true,"launched":false}\n'
    return
  fi
  local launcher=omarchy-launch-floating-terminal-with-presentation
  if ! have "$launcher"; then
    log "error: $launcher not found"
    printf '{"ok":false,"error":"%s not found; run: %s"}\n' "$launcher" "${steps[*]}"
    exit 1
  fi
  local script
  script=$(printf '%s && ' "${steps[@]}")
  script=${script% && }
  log "install: $script"
  setsid -f "$launcher" "$script" >/dev/null 2>&1
  printf '{"ok":true,"launched":true,"steps":%s}\n' "$(json_strings "${steps[@]}")"
}

# Open a floating terminal with the exact `systemctl enable --now avahi-daemon`
# line pre-filled, so the user can run it themselves. This is the user-facing
# entry point for enabling LAN discovery — the plugin itself never enables
# avahi-daemon.
cmd_enable_avahi() {
  local launcher=omarchy-launch-floating-terminal-with-presentation
  if ! have "$launcher"; then
    log "error: $launcher not found"
    printf '{"ok":false,"error":"%s not found"}\n' "$launcher"
    exit 1
  fi
  local script="sudo systemctl enable --now avahi-daemon"
  log "enable-avahi: $script"
  setsid -f "$launcher" "$script" >/dev/null 2>&1
  printf '{"ok":true,"launched":true}\n'
}

# ---------------------------------------------------------------------- main

cmd=${1:-}
[[ -n $cmd ]] || { sed -n 2,20p "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
shift
[[ $cmd == log ]] || log "run: $cmd $*"
case $cmd in
  log) cmd_log "$@" ;;
  status) cmd_status "$@" ;;
  pair) cmd_pair "$@" ;;
  connect) cmd_connect "$@" ;;
  disconnect) cmd_disconnect "$@" ;;
  tcpip) cmd_tcpip "$@" ;;
  mirror) cmd_mirror "$@" ;;
  dock) cmd_dock "$@" ;;
  undock) cmd_undock "$@" ;;
  stop) cmd_stop "$@" ;;
  install) cmd_install "$@" ;;
  enable-avahi) cmd_enable_avahi "$@" ;;
  *) json_error "unknown command: $cmd" ;;
esac
